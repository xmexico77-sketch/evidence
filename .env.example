# 证源 Evidence 环境变量模板
#
# 复制为 .env.local 后填写。该文件已在 .gitignore 中，不会被提交。
# 部署时（Docker / 云主机）用真实环境变量注入，不要把真实密钥写进仓库。

# ---------------- 模型 ----------------
# 必填：DeepSeek 平台申请
DEEPSEEK_API_KEY=
# 可选：默认官方地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：模型名（如平台调整，改这里即可，不用改代码）
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# ---------------- 认证 ----------------
# 1=启用登录（评测/公网部署必须启用）；0=关闭（本地开发方便）
AUTH_ENABLED=1
# 账号列表，格式 用户名:密码，逗号分隔
#   demo      —— 演示账号
#   reviewer  —— 评审专用账号（提交材料里要提供）
EVIDENCE_USERS=demo:demo2026,reviewer:review2026
# 令牌签名密钥，请改成一串随机值（例如 openssl rand -hex 24）
EVIDENCE_SECRET=please-change-this-to-a-random-string

# ---------------- 前端 ----------------
# 前端代理到后端的地址；Docker Compose 中为 http://api:8000
API_BASE=http://127.0.0.1:8000

# ---------------- 可选：镜像源 ----------------
# 国内网络建议取消注释
# HF_ENDPOINT=https://hf-mirror.com

# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# --- Node ---
node_modules/
.next/
out/

# --- 缓存与临时（绝不入库）---
.cache/
.tmp/
*.log

# --- 密钥：一律走环境变量，仓库只留模板 ---
.env
.env.local
.env.*.local

# --- 测试数据与派生产物：体积大且可复现，用脚本生成，不入库 ---
data/pdf/
data/parsed/
data/index/
data/figures/
# 长文档压测件（507 页 / 38MB），由 fetch_longdoc.py 生成，
# 刻意放在 pdf/ 之外，避免被 index_cli 当成正式文献索引进演示库
data/longdoc/

# --- 产出物 ---
dist/
build/
*.mp4
docs/preview/
docs/checks.json

# pip 解包临时目录与 jieba 缓存（安装依赖时留在仓库根目录，不属于项目）
pip-unpack-*/
jieba.cache
*.cache/
# 配音：只保留合成本段与清单，分段音频可由 make_voiceover.py 重新生成
docs/voiceover/shot*.mp3
docs/voiceover/dub*.mp3
docs/voiceover/dub*.srt

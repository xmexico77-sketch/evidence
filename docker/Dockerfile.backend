# 证源 Evidence · 后端镜像
#
# 注意：首次启动会从 HuggingFace 下载两个模型（合计约 640MB）：
#   BAAI/bge-small-en-v1.5        向量（67MB）
#   BAAI/bge-reranker-v2-m3-int8  重排（570MB）
# 建议把 /app/.cache 挂成卷，避免每次重建容器都重新下载。

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai

# pymupdf / opencv 需要的运行库
RUN apt-get update \
 && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY backend /app/backend
COPY scripts /app/scripts

# 缓存与数据目录（可挂卷）
RUN mkdir -p /app/.cache /app/data/pdf /app/data/index /app/data/figures /app/data/samples

WORKDIR /app/backend

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=4).status==200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
